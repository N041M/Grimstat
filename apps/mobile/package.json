{
  "name": "@grimstat/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build:web": "node ../../scripts/ocr-assets.mjs && VITE_STORE_BUILD=1 VITE_SITE_URL=https://grimstat.com VITE_BASE=/ pnpm --filter @grimstat/web build",
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cd android && ./gradlew assembleDebug",
    "bundle": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}

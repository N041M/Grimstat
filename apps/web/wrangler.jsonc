// The deployed site and its API, one Worker under grimstat.com.
//
// The files in dist/ are served as static assets and never reach the script. Only the paths in
// `run_worker_first` do: the sync API and the short links. A request for a file costs nothing
// against the Worker's daily allowance, which is why the split is drawn there.
//
// A path that matches no file gets a 404 rather than the app's page. The app routes by hash, so it
// never needs a fallback, and the Wahapedia copy under wahapedia/ is checked by fetching a file
// from it: a fallback there would hand the check a page of HTML with a 200 and it would read it as
// a table.
//
// Only the bare domain is served here. www is a redirect rule in the Cloudflare dashboard, with a
// placeholder DNS record for it, because a request answered by a rule never reaches the Worker
// and so never counts against its daily allowance.
//
// Setup, once, with wrangler signed in to the account:
//   pnpm --filter @grimstat/web exec wrangler d1 create grimstat      → the database_id below
//   pnpm --filter @grimstat/web exec wrangler secret put RESEND_API_KEY
//   pnpm --filter @grimstat/web exec wrangler secret put IP_SALT      → any long random string
// The deploy workflow applies apps/api/migrations before every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grimstat",
  "main": "../api/src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/l/*", "/u/*"]
  },
  "routes": [{ "pattern": "grimstat.com", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://grimstat.com",
    "MAIL_FROM": "Grimstat <hello@grimstat.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grimstat",
      "database_id": "52726ce3-ae31-4a14-8812-90b9c1bee092",
      "migrations_dir": "../api/migrations"
    }
  ],
  // One counter per kind of request, per address, per minute. The numbers match RATE_LIMITS in
  // apps/api/src/limits.ts. The namespace ids only have to differ from each other.
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LINKS_RL", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // The nightly purge of used codes, expired links and idle sessions.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
